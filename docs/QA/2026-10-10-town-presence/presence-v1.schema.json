{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://holobots.dev/schemas/presence-v1",
  "title":"M1 host-owned town presence",
  "oneOf":[{"$ref":"#/$defs/heartbeat"},{"$ref":"#/$defs/leave"},{"$ref":"#/$defs/emote"},{"$ref":"#/$defs/ack"},{"$ref":"#/$defs/aggregate"}],
  "$defs":{
    "botId":{"enum":["ace","ken","wolf","kuma","hare","shadow","tora","gama","era","wake","kurai","tsuin"]},
    "heartbeat":{"type":"object","required":["schemaVersion","operation","scene","pos","yaw","deployed"],"properties":{"schemaVersion":{"const":"presence-1"},"operation":{"const":"heartbeat"},"scene":{"const":"HoloCity_Main"},"pos":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},"yaw":{"type":"number"},"deployed":{"type":"array","maxItems":3,"uniqueItems":true,"items":{"$ref":"#/$defs/botId"}}}},
    "leave":{"type":"object","required":["schemaVersion","operation"],"properties":{"schemaVersion":{"const":"presence-1"},"operation":{"const":"leave"}}},
    "emote":{"type":"object","required":["schemaVersion","operation","emote"],"properties":{"schemaVersion":{"const":"presence-1"},"operation":{"const":"emote"},"emote":{"const":"wave"}}},
    "ack":{"type":"object","additionalProperties":false,"required":["schemaVersion","visible","expiresAtMs"],"properties":{"schemaVersion":{"const":"presence-1"},"visible":{"type":"boolean"},"expiresAtMs":{"type":"integer","minimum":0}}},
    "pilot":{"type":"object","additionalProperties":false,"required":["schemaVersion","preset","heightScale","faceLayers","parts","shapes","colors"],"properties":{"schemaVersion":{"const":"wardrobe-3"},"preset":{"type":["string","null"]},"heightScale":{"type":"number","minimum":0.9,"maximum":1},"faceLayers":{"type":"object","additionalProperties":{"type":["string","null"]}},"parts":{"type":"object","additionalProperties":{"type":["string","null"]}},"shapes":{"type":"object","additionalProperties":{"type":"number","minimum":0,"maximum":100}},"colors":{"type":"object","additionalProperties":{"oneOf":[{"type":"string","pattern":"^#[0-9A-Fa-f]{6}$"},{"type":"array","maxItems":8,"items":{"type":"string","pattern":"^#[0-9A-Fa-f]{6}$"}}]}}}},
    "row":{"type":"object","additionalProperties":false,"required":["username","pilot","squad","deployed","pos","yaw","updatedAtMs","expiresAtMs"],"properties":{"username":{"type":"string","minLength":1,"maxLength":64},"pilot":{"$ref":"#/$defs/pilot"},"squad":{"type":"array","maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["holobotId","level","rank"],"properties":{"holobotId":{"$ref":"#/$defs/botId"},"level":{"type":"integer","minimum":1,"maximum":1000},"rank":{"type":"string","minLength":1,"maxLength":32}}}},"deployed":{"type":"array","maxItems":3,"uniqueItems":true,"items":{"$ref":"#/$defs/botId"}},"pos":{"type":"array","minItems":3,"maxItems":3,"prefixItems":[{"type":"number","minimum":-256,"maximum":256},{"type":"number","minimum":-64,"maximum":256},{"type":"number","minimum":-256,"maximum":256}],"items":false},"yaw":{"type":"number","minimum":0,"exclusiveMaximum":360},"updatedAtMs":{"type":"integer","minimum":0},"expiresAtMs":{"type":"integer","minimum":0},"emote":{"const":"wave"},"emoteExpiresAtMs":{"type":"integer","minimum":0}}},
    "aggregate":{"type":"object","additionalProperties":false,"required":["schemaVersion","pilots"],"properties":{"schemaVersion":{"const":"presence-1"},"pilots":{"type":"object","additionalProperties":{"$ref":"#/$defs/row"}}}}
  }
}
