rules_version = '2';

// Holobots Firestore Security Rules
// -----------------------------------------------------------------------------
// SECURITY MODEL
//
// Since holobots-write-lockdown-1 (Pak 2026-10-23, "yes, lock it down") a
// client UPDATE of /users/{uid} may touch ONLY the keys in
// clientWritableKeys() below (energy regen, the rewardSystem display /
// quest-board copy, and three settings). Everything else on the profile —
// holobots (stats, levels, XP, attributes, sync stats), currency, items,
// cards, parts, leaderboard inputs — is written only by the callables
// (Admin SDK bypasses rules). A client CREATE carries no economy at all:
// sign-up goes through createGenesisProfile. These rules also:
//   * require authentication for every read/write,
//   * scope every document to its owner (no cross-account reads/writes),
//   * block privilege escalation (isDevAccount, uid spoofing),
//   * restrict PvP room/pool writes to participants.
// See SECURITY_AUDIT.md and Documentation/HANDOFFS for the history.
// -----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // A defensive upper bound. Far above any legitimate balance, but blocks
    // the "set my currency to 1e9" class of tampering. Not a substitute for
    // server-authoritative economy (see header).
    function sane(n) {
      return n is number && n >= 0 && n <= 100000000;
    }

    function saneOptional(data, field) {
      return !(field in data) || sane(data[field]);
    }

    // Fields the client must never be able to set/raise itself.
    function noPrivilegeEscalation(data) {
      return !('isDevAccount' in data) || data.isDevAccount == false;
    }

    // Epoch-millisecond timestamps written by client fallbacks (sane() caps
    // at 1e8, far below Date.now()).
    function saneEpochMsOptional(data, field) {
      return !(field in data)
        || (data[field] is number && data[field] >= 0 && data[field] < 100000000000000);
    }

    // Referral/Genesis fields are awarded only by the growth callables and
    // the fitness-sync qualification hook (Admin SDK bypasses rules). On
    // update they are covered by protectedFieldsUntouched below.
    function referralFieldsAbsent(data) {
      return !('referredBy' in data)
        && !('referrals' in data)
        && !('referralQualified' in data)
        && !('genesisSquadClaimed' in data)
        && !('genesisBadge' in data);
    }

    // referralCode IS client-writable (owners lazily publish their own code
    // so applyReferralCode can query it). Spoofing someone else's code is
    // inert — the callable re-derives the code from the matched doc's uid —
    // so a length cap is the only constraint worth enforcing here.
    function referralCodeSane(data) {
      return !('referralCode' in data)
        || (data.referralCode is string && data.referralCode.size() <= 12);
    }

    // ---- client write allowlist (holobots-write-lockdown-1, 2026-10-23) -------
    // The ONLY profile keys a client may add / change / remove on update. One
    // MapDiff hasOnly = one expression regardless of how many fields the
    // account has populated (EVALUATION BUDGET note below). Writing any other
    // field with its UNCHANGED value stays legal (full-profile merges).
    //   (dailyEnergy, lastEnergyRefresh, stepEnergyDate, stepEnergyGrantedToday
    //   left this list in energy-quest-server-1, 2026-10-23: regen runs on the
    //   host — refreshEnergy and the quest / training start callables — with the
    //   daily reset at the account's local midnight, see functions/src/lib/energyRegen.ts.)
    //   rewardSystem: quest-board / sync-boost preferences + the display copy of
    //     quest / training runs and daily missions. Nothing pays from it: payouts
    //     validate against progressionTimers / dailyMissionLedger (server-only).
    //   syncDistanceUnit ("km" | "mi"), referralCode (own code, see
    //   referralCodeSane), presenceOptOut (bool): settings, no economy.
    function clientWritableKeys() {
      return [
        'rewardSystem',
        'syncDistanceUnit', 'referralCode', 'presenceOptOut'
      ];
    }

    function onlyClientWritableKeysChanged(data, existing) {
      return data.diff(existing).affectedKeys().hasOnly(clientWritableKeys());
    }

    function syncDistanceUnitSane(data, existing) {
      return !('syncDistanceUnit' in data)
        || data.syncDistanceUnit == existing.get('syncDistanceUnit', null)
        || data.syncDistanceUnit in ['km', 'mi'];
    }

    // A client CREATE (mobile and desktop sign-up both use createGenesisProfile)
    // may only carry these keys: no holobots, currency, items or cards.
    function clientCreateKeys() {
      return clientWritableKeys().concat(['isDevAccount', 'fitnessSource', 'onboardingPath']);
    }

    // ---- economy freeze (2026-07-12) ----------------------------------------
    // Currency, items, loot, and fitness-derived stats are paid ONLY by the
    // callables (Admin SDK bypasses rules). The mobile client fallbacks were
    // removed the same day; the holobots-fun web app's client-side economy
    // writes break by design until it migrates (owner decision).
    // holobots-write-lockdown-1 (2026-10-23) closed the rest: holobots
    // (attribute spends -> boostHolobotAttribute, sync-ability equips ->
    // equipSyncAbility, kit saves -> saveHolobotCombatKit), equippedParts
    // (-> equipHolobotPart), battle_cards / arena_deck_template_ids /
    // starter_deck_claimed (-> createGenesisProfile / claimStarterDeck),
    // inventory, leaderboardScore (the leaderboard mirror recomputes it),
    // prestigeCount, asyncBattleTickets, maxDailyEnergy are server-only, and
    // clientWritableKeys() above is the whole client surface.
    // Daily missions (2026-10-17 critic review S2): the counters and claims
    // claimDailyMission pays from live in dailyMissionLedger, server-only
    // below. rewardSystem stays owner-writable for the quest-board / sync-boost
    // preferences; since energy-quest-server-1 every quest / training START
    // (main app + lite) goes through startQuestRun / startTrainingSession.
    // Quest / training timers (S3, hardening-2): claimQuestRun /
    // claimTrainingSession validate against progressionTimers, server-only
    // below and written only by startQuestRun / startTrainingSession; the
    // rewardSystem quest/training entries are a display copy.
    // EVALUATION BUDGET (2026-07-18): rules abort past 1000 expression
    // evaluations per request. The old shape chained ~30 per-field frozen
    // checks whose cost grew with every POPULATED field, so real accounts
    // (post-gacha, post-referral) blew the budget and got PERMISSION_DENIED
    // on every client write — equips failed on device while thin test
    // fixtures passed. One MapDiff covers all protected fields in a single
    // expression, and is stricter: it also blocks DELETING a frozen field,
    // which the unchanged-or-absent shape silently allowed. Writing a frozen
    // field with an UNCHANGED value stays legal (full-profile merges).
    function protectedFieldsUntouched(data, existing) {
      return !data.diff(existing).affectedKeys().hasAny([
        'holosTokens', 'syncPoints', 'lifetimeSyncPoints', 'seasonSyncPoints',
        'syncRank', 'gachaTickets', 'arenaPassses', 'expBoosters',
        'energyRefills', 'emergencyPatches', 'holobotVitals', 'itemStocks', 'rankSkips', 'wins', 'losses', 'blueprints',
        'wildcardBlueprints', 'legendaryBlueprints', 'expBoosterActiveUntil',
        'lastWildcardPackAt', 'parts', 'packHistory', 'todaySteps',
        'referredBy', 'referrals', 'referralQualified', 'genesisSquadClaimed',
        'genesisBadge', 'isDevAccount', 'travelSquad',
        // DECISIONS #43/#44: Buddy Unit inventory (#44: the {light, medium, heavy}
        // tier map; a nested change is an affected top-level key) + rival ladder
        // are server-only.
        'buddyUnits', 'rivalWins', 'rivalRewardDay',
        // DECISIONS #58 (3): the once-per-bot-per-tier rank Kit record.
        'rankKitTiers', 'storyFlags', 'pilotRank', 'tournamentUnlocks', 'tournamentUnlockAcknowledged', 'expeditionSupplies', 'expeditionBank',
        // 2026-10-17 critic review S2: daily-mission counters + claims.
        'dailyMissionLedger',
        // 2026-10-17 critic review S3 (hardening-2): host-clock quest / training start records.
        'progressionTimers', 'syncReadiness',
        // onboarding-host-1 (DECISIONS #72.3–#72.5): the host-owned onboarding step.
        'onboarding',
        // holobots-write-lockdown-1: the roster (stats / levels / XP / attributes / sync
        // stats / equipped abilities), cards, parts loadout, items and leaderboard inputs.
        'holobots', 'equippedParts', 'battle_cards', 'arena_deck_template_ids',
        'starter_deck_claimed', 'inventory', 'leaderboardScore', 'prestigeCount',
        'asyncBattleTickets', 'lastAsyncTicketRefresh', 'maxDailyEnergy',
        'attributeBoostRequestIds',
        // energy-quest-server-1: energy balance + regen clocks + the account's
        // stored reset zone (refreshEnergy / startQuestRun / startTrainingSession).
        'dailyEnergy', 'lastEnergyRefresh', 'stepEnergyDate', 'stepEnergyGrantedToday',
        'energyDayKey', 'energyDayStartedAt', 'energyTimeZone', 'energyTimeZoneChangedAt'
      ]);
    }

    // On CREATE the frozen fields may only carry their signup defaults.
    function frozenZeroOnCreate(data, field) {
      return !(field in data) || data[field] == 0;
    }
    function frozenEmptyOnCreate(data, field) {
      return !(field in data) || data[field].size() == 0;
    }
    function economyFrozenOnCreate(data) {
      return frozenZeroOnCreate(data, 'holosTokens')
        && frozenZeroOnCreate(data, 'syncPoints')
        && frozenZeroOnCreate(data, 'lifetimeSyncPoints')
        && frozenZeroOnCreate(data, 'seasonSyncPoints')
        && (!('syncRank' in data) || data.syncRank == 'Rookie')
        && frozenZeroOnCreate(data, 'gachaTickets')
        && frozenZeroOnCreate(data, 'arenaPassses')
        && frozenZeroOnCreate(data, 'expBoosters')
        && frozenZeroOnCreate(data, 'energyRefills')
        && frozenZeroOnCreate(data, 'emergencyPatches')
        && !('holobotVitals' in data)
        && !('itemStocks' in data)
        && frozenZeroOnCreate(data, 'rankSkips')
        && frozenZeroOnCreate(data, 'wins')
        && frozenZeroOnCreate(data, 'losses')
        && frozenEmptyOnCreate(data, 'blueprints')
        && frozenZeroOnCreate(data, 'wildcardBlueprints')
        && frozenZeroOnCreate(data, 'legendaryBlueprints')
        && !('travelSquad' in data)
        && !('buddyUnits' in data)
        && !('rivalWins' in data)
        && !('rivalRewardDay' in data)
        && !('rankKitTiers' in data)
        && !('storyFlags' in data)
        && !('pilotRank' in data)
        && !('tournamentUnlocks' in data)
        && !('tournamentUnlockAcknowledged' in data)
        && !('expeditionSupplies' in data)
        && !('expeditionBank' in data)
        && !('dailyMissionLedger' in data)
        && !('progressionTimers' in data)
        && !('syncReadiness' in data)
        && !('onboarding' in data)
        && !('expBoosterActiveUntil' in data)
        && !('lastWildcardPackAt' in data)
        && frozenEmptyOnCreate(data, 'parts')
        && frozenEmptyOnCreate(data, 'packHistory')
        && frozenZeroOnCreate(data, 'todaySteps');
    }

    // Numeric economy fields we sanity-check on write.
    function economyFieldsSane(data) {
      return saneOptional(data, 'holosTokens')
        && saneOptional(data, 'syncPoints')
        && saneOptional(data, 'lifetimeSyncPoints')
        && saneOptional(data, 'seasonSyncPoints')
        && saneOptional(data, 'gachaTickets')
        && saneOptional(data, 'arenaPassses')
        && saneOptional(data, 'expBoosters')
        && saneOptional(data, 'energyRefills')
        && saneOptional(data, 'rankSkips')
        && saneOptional(data, 'asyncBattleTickets')
        && saneOptional(data, 'dailyEnergy')
        && saneOptional(data, 'maxDailyEnergy')
        && saneOptional(data, 'stepEnergyGrantedToday')
        && saneOptional(data, 'leaderboardScore')
        && saneOptional(data, 'prestigeCount')
        && saneOptional(data, 'wins')
        && saneOptional(data, 'losses')
        && saneOptional(data, 'todaySteps')
        && saneOptional(data, 'wildcardBlueprints')
        && saneEpochMsOptional(data, 'lastWildcardPackAt');
    }

    function presenceOptOutSane(data) {
      return !('presenceOptOut' in data) || data.presenceOptOut is bool;
    }

    // ---- users -------------------------------------------------------------
    // Read: OWNER ONLY (privacy hardening 2026-07-13). The leaderboard reads
    // the /leaderboard projection below — full user documents are no longer
    // exposed to other players.
    // Write: owner only, with anti-escalation + sanity validation.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(clientCreateKeys())
        && syncDistanceUnitSane(request.resource.data, {})
        && noPrivilegeEscalation(request.resource.data)
        && economyFieldsSane(request.resource.data)
        && economyFrozenOnCreate(request.resource.data)
        && referralFieldsAbsent(request.resource.data)
        && referralCodeSane(request.resource.data)
        && presenceOptOutSane(request.resource.data);

      // isDevAccount is inside the protected set: a MapDiff "affected" key
      // means added/removed/CHANGED, so a legacy account that already has
      // isDevAccount: true keeps writing normally (unchanged value is not
      // affected) while any flip in either direction is denied.
      allow update: if isOwner(uid)
        && onlyClientWritableKeysChanged(request.resource.data, resource.data)
        && economyFieldsSane(request.resource.data)
        && protectedFieldsUntouched(request.resource.data, resource.data)
        && syncDistanceUnitSane(request.resource.data, resource.data)
        && referralCodeSane(request.resource.data)
        && presenceOptOutSane(request.resource.data);

      // Server-only (2026-10-01 cloud review #1): a client delete + recreate
      // would wipe buddyUnits / rivalWins / rivalRewardDay and let the server
      // re-grant the starter Buddy Unit ("missing field = never seen").
      // Account deletion goes through deleteUserAccountV2 (Admin SDK).
      allow delete: if false;

      // fitness_daily is SERVER-ONLY since the 2026-07-13 hardening: the
      // sync callables both write it and trust its workoutSessionsCompleted
      // for the daily reward cap, so a client write could dodge the cap.
      // (The legacy client writers were removed with the economy freeze.)
      match /fitness_daily/{day} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Owner-scoped subcollections (equip loadouts, etc.).
      //
      // IMPORTANT: in rules_version '2', a bare `match /{document=**}` here
      // ALSO matches /users/{uid} itself (recursive wildcards match zero or
      // more segments), which would OR a blanket owner-allow over the
      // validated create/update rules above and silently disable
      // economyFieldsSane + noPrivilegeEscalation. The extra {subcollection}
      // segment forces this block to apply only to documents strictly below
      // the user document. Regression coverage: rules-tests/tests/
      // auth-privilege.test.ts and mobile-writes.test.ts.
      match /{subcollection}/{document=**} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && subcollection != 'fitness_daily';
      }
    }

    // ---- remote app config ---------------------------------------------------
    // Console/Admin-edited documents (e.g. config/appDistribution.inviteUrl:
    // the TestFlight link during beta, the App Store URL after launch).
    match /config/{document} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- public leaderboard projection --------------------------------------
    // Written ONLY by the mirrorLeaderboardEntry trigger (Admin SDK).
    // Contains public fields exclusively: username, leaderboardScore, wins,
    // prestigeCount, highestHolobotLevel, syncRank, genesisBadge.
    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- PvP matchmaking pool ---------------------------------------------
    // Entries are self-describing via their userId field: the mobile client
    // keys docs by uid (one entry per player), the web client still writes
    // auto-ID docs, so ownership checks the field rather than the path
    // segment. Any signed-in searcher may CLAIM an active entry — flip
    // isActive to false and stamp the shared roomId, touching exactly those
    // two fields — which the transactional pairing in
    // mobile/src/lib/pvpMatchmaking.ts commits atomically with the room
    // creation so two simultaneous searchers can never both create rooms.
    match /battle_pool_entries/{entryId} {
      function ownsEntry() {
        return isSignedIn() && resource.data.get('userId', '') == request.auth.uid;
      }
      function isClaim() {
        return isSignedIn()
          && resource.data.get('isActive', false) == true
          && request.resource.data.get('isActive', true) == false
          && request.resource.data.get('roomId', '') != ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'roomId']);
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if ownsEntry() || isClaim();
      allow delete: if ownsEntry();
    }

    // ---- PvP battle rooms --------------------------------------------------
    // Participant uids live at players.p1.uid / players.p2.uid — the only
    // shape either client (mobile or holobots-fun web) has ever written. The
    // previous rule checked top-level hostId/guestId/p1/p2 fields that never
    // existed, so every real participant update (heartbeat, stamina regen,
    // playCard, join) was denied. Writes are limited to the two recorded
    // participants, plus a joiner filling the empty p2 slot of a waiting
    // room. This still does NOT validate individual moves (a participant can
    // write an illegal board state) — authoritative move validation requires
    // a Cloud Function (SECURITY_AUDIT.md C4).
    match /battle_rooms/{roomId} {
      function isParticipant(data) {
        return isSignedIn()
          && (request.auth.uid == data.get(['players', 'p1', 'uid'], '')
              || request.auth.uid == data.get(['players', 'p2', 'uid'], ''));
      }
      function isJoiningOpenSlot() {
        return isSignedIn()
          && resource.data.get('status', '') == 'waiting'
          && resource.data.get(['players', 'p2', 'uid'], '') == ''
          && request.resource.data.get(['players', 'p2', 'uid'], '') == request.auth.uid;
      }
      allow read: if isSignedIn();
      allow create: if isParticipant(request.resource.data);
      allow update: if isParticipant(resource.data) || isJoiningOpenSlot();
      allow delete: if isParticipant(resource.data);
    }

    // ---- server-only state (DECISIONS #46 / #47 / #48) ------------------------
    // Intro quest chain state and Buddy Unit purchase receipts are written
    // only by the callables (Admin SDK). Explicit here so a future wildcard
    // can't open them; the default deny below covers them too. No client
    // read: the callables return everything Unity renders.
    match /introQuests/{uid} {
      allow read, write: if false;
    }
    // DECISIONS #48 wardrobe (entitlements, saved appearance recipe, receipts):
    // written only by wardrobeHost. No client read either: wardrobeHost
    // `status` returns everything Unity renders, so no stored shape becomes
    // a client contract.
    // M1 public projection: one point-read per poll, signed-in only. No list or client writes.
    match /presenceScenes/{scene} {
      allow get: if isSignedIn() && scene == 'HoloCity_Main';
      allow list, write: if false;
    }

    match /wardrobes/{uid}/{document=**} {
      allow read, write: if false;
    }
    match /vendorPurchases/{uid}/{document=**} {
      allow read, write: if false;
    }
    // DECISIONS #53 amendment 1: HoloZone (Error Beast) runs — server-issued run ids and their
    // once-per-run XP rulings, written only by holoZoneHost. Kept off users/{uid} because that
    // doc is client-writable outside protectedFieldsUntouched (a forged run would farm XP). No
    // client read: holoZoneHost `status` returns the open run. Same effect as the default deny.
    match /holoZoneRuns/{uid}/{document=**} {
      allow read, write: if false;
    }

    // Durable Arena admission, lease and receipts: callable-only at every depth.
    match /arenaMatches/{uid}/{document=**} {
      allow read, write: if false;
    }

    // Tournament bracket state and resolver receipts are callable-only.
    match /arenaBrackets/{uid}/{document=**} {
      allow read, write: if false;
    }

    // DECISIONS #54-1: Zell's story phase is host-owned; clients use rivalBattleHost.
    match /storyProgress/{uid}/{document=**} {
      allow read, write: if false;
    }

    // ---- default deny ------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
