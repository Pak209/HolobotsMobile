# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
#
# Customize the NODE_BINARY variable here.
# For example, to use nvm with brew, add the following line
# . "$(brew --prefix nvm)/nvm.sh" --no-use
export NODE_BINARY=$(command -v node)

# HoloCity lite release gate (DECISIONS #72.7 D6). This line exists ONLY on the
# release/lite-1.1.0 commit; main keeps it absent so normal builds stay gate-off.
# The "Bundle React Native code and images" phase sources this file, so
# `expo export:embed` inlines EXPO_PUBLIC_HOLOCITY_LITE=1 into the Release bundle.
# mobile/scripts/testflight-preflight.py --expect-lite on asserts every source agrees.
export EXPO_PUBLIC_HOLOCITY_LITE=1

# Client twins of host flags merged on main ("turn on all of the switches", 2026-10-23).
# Release-branch only, like the lite gate above; each mirrors a host flag that must be ON in
# the deployed functions too. Flags for unmerged features (signatures, Zell, expedition) stay off.
# --expect-lite on also asserts these from every source and in the --bundle.
#   FIGHT_ATTRS -> host HOLOCITY_FIGHT_ATTRS (progressionRules5Enabled, #72.78 progression)
#   READINESS   -> host HOLOCITY_READINESS_* (readinessUiEnabled, read-only readiness UI)
export EXPO_PUBLIC_HOLOCITY_FIGHT_ATTRS=1
export EXPO_PUBLIC_HOLOCITY_READINESS=1
