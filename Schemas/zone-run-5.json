          "minimum": 0
        },
        "maxHealth": {
          "type": "number",
          "minimum": 0
        },
        "currentHealth": {
          "type": "number",
          "minimum": 0
        },
        "attack": {
          "type": "number",
          "minimum": 0
        },
        "defense": {
          "type": "number",
          "minimum": 0
        },
        "speed": {
          "type": "number",
          "minimum": 0
        },
        "maxStamina": {
