{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zone-run-5",
  "title": "zone-run-5 holoZoneHost request or successful reply",
  "description": "Additive over zone-run-4 (HolobotsMobile Contract-Change zone-run-5; Holocity DECISIONS #72.75, design HANDOFFS/2026-10-23-holozones-signatures.md). The HoloZones signature pilot (FORECAST + SLIPSTREAM). Same requests and rulings as zone-run-4 under schemaVersion zone-run-5, plus the signature operation; run views add signaturePool, signatureArmed, forecasts, slipOpened and protectedSlots; layout sectors add signatureBlocked; the signature reply carries signatureResult. Accepted only while the host's HOLOCITY_ZONE_SIGNATURES flag is on (default off: refused invalid_request). zone-run-3 / zone-run-4 requests still get exactly their shapes. zone-extract-1 requests and any reply that closes the run keep their existing schemas with the zone-run-3 run view. Refusals are callable errors, not success objects: signature adds signature_unknown, signature_not_in_squad, signature_no_charge, signature_cooling (details.retryAfterMs, host clock), signature_already_armed (reserved, phase 3), signature_not_here, forecast_not_ahead, nothing_to_protect (reserved, phase 4); fight adds sector_slipped (a slipped sector forfeits its encounter and cache). Register zone-run-3, zone-extract-1, duel-intents-1 and duel-receipt-1 alongside. Shape checks do not authenticate or resolve gameplay; cross-field host invariants remain authoritative.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/reply"
    }
  ],
  "$defs": {
    "haul": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "blueprint_fragment",
            "rare_blueprint_fragment",
            "bulky_salvage"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        },
        "protected": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "amount",
        "protected"
      ]
    },
    "supplies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "energy": {
          "type": "integer",
          "minimum": 0
        },
        "extractionCharges": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "energy",
        "extractionCharges"
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^zone-config-[a-zA-Z0-9_-]{1,64}$"
        },
        "energyCapacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "energyPackUnits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "energyPackPrice": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "sectorEnergyCost": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "fightEnergyCost": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "extractionChargePrice": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "cacheFragments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "bulkySalvageUnits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "rareBlueprintChanceBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "bandLevels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "version",
        "energyCapacity",
        "energyPackUnits",
        "energyPackPrice",
        "sectorEnergyCost",
        "fightEnergyCost",
        "extractionChargePrice",
        "cacheFragments",
        "bulkySalvageUnits",
        "rareBlueprintChanceBasisPoints",
        "bandLevels"
      ]
    },
    "sector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "band": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "safe": {
