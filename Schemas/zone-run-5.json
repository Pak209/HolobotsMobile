    "utilityResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the host resolved for this utility use. effect none = nothing to do here (route already open, barrier already down, haul full): not spent, no cooldown.",
      "properties": {
        "sectorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "utility": {
          "enum": [
            "ace",
            "shadow",
            "kuma"
          ]
        },
        "effect": {
          "enum": [
            "route",
            "cache",
            "clear",
            "none"
          ]
        },
        "opensSectorId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "haul": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/haul"
          },
          "maxItems": 9,
          "description": "Rows this use added; also present (unbanked) in run.haul."
        },
        "spent": {
          "type": "boolean"
        },
        "cooldownMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sectorId",
        "utility",
        "effect",
        "opensSectorId",
        "haul",
        "spent",
        "cooldownMs"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "spent": {
                "const": false
              },
              "cooldownMs": {
                "type": "null"
              },
              "opensSectorId": {
                "type": "null"
              },
              "haul": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "spent": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "route"
              }
            }
          },
          "then": {
            "properties": {
              "opensSectorId": {
                "type": "string"
              },
              "haul": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "cache"
              }
            }
          },
          "then": {
            "properties": {
              "opensSectorId": {
                "type": "null"
              },
              "haul": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "clear"
              }
            }
          },
          "then": {
            "properties": {
              "opensSectorId": {
                "type": "null"
              },
              "haul": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "signatureKind": {
      "enum": [
        "forecast",
        "slipstream",
        "snare",
        "aegis",
        "lockbox"
      ],
      "description": "Signature kind (one pool per kind). Pilot hosts build forecast and slipstream; the others are refused signature_unknown until built."
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "description": "A host FORECAST read of one sector's fight: the threat's opening actions (exact for the real fight with explicit intents) and the reference-plan projection bucket. Projection, not promise.",
      "properties": {
        "sectorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "openingIntents": {
          "type": "array",
          "items": {
            "enum": [
              "strike",
              "heavy",
              "defend",
              "finisher"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "description": "The threat's first (up to) 3 requested actions in that fight; fewer only when the projected fight ends sooner."
        },
        "projection": {
          "enum": [
            "clean",
            "bruised",
            "heavy",
            "wipe_risk"
          ],
          "description": "Reference plan vs the squad's HP now: clean >= 85 %, bruised 60-85 %, heavy < 60 % (won), wipe_risk = the reference plan loses."
        }
      },
      "required": [
        "sectorId",
        "openingIntents",
        "projection"
      ]
    },
    "signaturePool": {
      "type": "object",
      "additionalProperties": false,
      "description": "Built at issue from the pinned squad: one entry per kind present (duplicate holders add insurance, never charges). Charges are per run and never refill.",
      "properties": {
        "forecast": {
          "$ref": "#/$defs/signaturePoolEntry"
        },
        "slipstream": {
          "$ref": "#/$defs/signaturePoolEntry"
        },
        "snare": {
          "$ref": "#/$defs/signaturePoolEntry"
        },
        "aegis": {
          "$ref": "#/$defs/signaturePoolEntry"
        },
        "lockbox": {
          "$ref": "#/$defs/signaturePoolEntry"
        }
      }
    },
    "signaturePoolEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "charges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "holders": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$"
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "description": "Squad holobot ids that carry this kind; a living one is required to act."
        }
      },
      "required": [
        "charges",
        "max",
        "holders"
      ]
    },
    "signatureResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the host resolved for this signature use. effect none = nothing to do (already forecast or cleared target; this sector's utility point already chosen; already slipped): not spent, no cooldown. sectorId = the sector the effect is about (forecast: the target; slipstream: the current sector).",
      "properties": {
        "signature": {
          "$ref": "#/$defs/signatureKind"
        },
        "holobotId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "sectorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "effect": {
          "enum": [
            "forecast",
            "armed",
            "route",
            "protect",
            "none"
          ]
        },
        "spent": {
          "type": "boolean"
        },
        "chargesLeft": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "cooldownMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "opensSectorId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "forecast": {
          "anyOf": [
            {
              "$ref": "#/$defs/forecast"
            },
            {
              "type": "null"
            }
          ]
        },
        "protectedSlots": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "signature",
        "holobotId",
        "sectorId",
        "effect",
        "spent",
        "chargesLeft",
        "cooldownMs",
        "opensSectorId",
        "forecast",
        "protectedSlots"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "spent": {
                "const": false
              },
              "cooldownMs": {
                "type": "null"
              },
              "opensSectorId": {
                "type": "null"
              },
              "protectedSlots": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "spent": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "route"
              }
            }
          },
          "then": {
            "properties": {
              "signature": {
                "const": "slipstream"
              },
              "opensSectorId": {
                "type": "string"
              },
              "forecast": {
                "type": "null"
              },
              "protectedSlots": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "forecast"
              }
            }
          },
          "then": {
            "properties": {
              "signature": {
                "const": "forecast"
              },
              "opensSectorId": {
                "type": "null"
              },
              "forecast": {
                "$ref": "#/$defs/forecast"
              },
              "protectedSlots": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "armed"
              }
            }
          },
          "then": {
            "properties": {
              "signature": {
                "enum": [
                  "snare",
                  "aegis"
                ]
              },
              "opensSectorId": {
                "type": "null"
              },
              "forecast": {
                "type": "null"
              },
              "protectedSlots": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "protect"
              }
            }
          },
          "then": {
            "properties": {
              "signature": {
                "const": "lockbox"
              },
              "opensSectorId": {
                "type": "null"
              },
              "forecast": {
                "type": "null"
              },
              "protectedSlots": {
                "type": "integer"
              }
            }
          }
        }
      ]
    }
  }
}
