    "reply": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemaVersion": {
              "const": "zone-run-5"
            },
            "layout": {
              "$ref": "#/$defs/layout"
            },
            "config": {
              "$ref": "#/$defs/config"
            }
          },
          "required": [
            "schemaVersion",
            "layout",
            "config"
          ]
        },
        {
