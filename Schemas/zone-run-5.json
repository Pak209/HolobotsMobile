          "additionalProperties": false,
          "properties": {
            "schemaVersion": {
              "const": "zone-run-5"
            },
            "operation": {
              "const": "protect"
            },
            "requestId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            "runId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            "haulId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            }
          },
          "required": [
            "schemaVersion",
            "operation",
            "requestId",
            "runId",
            "haulId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemaVersion": {
              "const": "zone-run-5"
            },
            "operation": {
              "const": "heal"
            },
            "requestId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            "runId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            "holobotId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            }
          },
          "required": [
            "schemaVersion",
