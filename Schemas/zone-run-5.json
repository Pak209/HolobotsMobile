                    "aegis"
                  ]
                },
                "holobotId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                }
              },
              "required": [
                "kind",
                "holobotId"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Armed combat signature (phase 3); always null in the pilot."
        },
        "forecasts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forecast"
          },
          "maxItems": 10,
          "description": "Every forecast taken this run (persisted so replays and reconnects show the same read)."
        },
        "slipOpened": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$"
          },
          "uniqueItems": true,
          "maxItems": 10,
          "description": "Sectors slipped with SLIPSTREAM: their deeper gate is open without a clear; the encounter and its cache are forfeit."
        },
        "protectedSlots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "description": "Protected haul slots this run (LOCKBOX, phase 4); always 1 in the pilot."
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "state",
        "issuedAtMs",
        "config",
        "layout",
        "opponents",
        "sectorId",
        "visited",
        "cleared",
        "looted",
        "squad",
        "energy",
        "kits",
        "charge",
        "haul",
        "guardianDefeated",
        "extraction",
        "receipt",
        "revision",
        "seed",
        "band",
        "sector",
        "protectedSlot",
        "utilityUsed",
        "signaturePool",
        "signatureArmed",
        "forecasts",
        "slipOpened",
        "protectedSlots"
      ]
    },
    "request": {
      "oneOf": [
