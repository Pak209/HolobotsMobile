        },
        "beacon": {
          "type": "boolean"
        },
        "neighbors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cache": {
          "type": "boolean"
        },
        "rareDiscovery": {
          "type": "boolean"
        },
        "guardian": {
          "type": "boolean"
        },
        "utility": {
          "enum": [
            "ace",
            "shadow",
            "kuma",
            null
          ]
        },
        "glimpse": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Host-authored preview line for this sector (presentation copy, placeholder until Lex/Pak approve)."
        },
        "dangerLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Host danger label of the sector's band (bands 1-3; absent on entry). Presentation copy."
        },
        "signatureBlocked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signatureKind"
          },
          "uniqueItems": true,
          "maxItems": 5,
          "description": "Kinds the host always refuses for this sector (slipstream acting here: safe rooms, band 3, the guardian; forecast targeting here: safe sectors). zone-run-5 layouts only; static per layout."
        }
      },
      "required": [
        "id",
        "band",
        "safe",
        "beacon",
        "neighbors",
        "cache",
        "rareDiscovery",
        "guardian",
        "utility"
