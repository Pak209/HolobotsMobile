        },
        "issuedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "config": {
          "$ref": "#/$defs/config"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "opponents": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/fighter"
          }
        },
        "sectorId": {
          "type": "string"
        },
        "visited": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "maxItems": 10
        },
        "cleared": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "maxItems": 10
        },
        "looted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "maxItems": 10
        },
        "squad": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fighter"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "energy": {
          "type": "integer",
          "minimum": 0
        },
        "kits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "charge": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "haul": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/haul"
          },
          "maxItems": 9
        },
        "guardianDefeated": {
          "type": "boolean"
        },
        "extraction": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "startedAtMs": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "startedAtMs"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "zone-extract-1#/$defs/receipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "band": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "sector": {
          "type": "string"
        },
        "protectedSlot": {
          "anyOf": [
            {
              "$ref": "#/$defs/haul"
            },
            {
              "type": "null"
            }
          ]
        },
        "utilityUsed": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$"
          },
          "uniqueItems": true,
          "maxItems": 10,
          "description": "Sector ids whose companion utility was spent this run (one-shot per run+sector)."
        },
        "signaturePool": {
          "$ref": "#/$defs/signaturePool"
        },
        "signatureArmed": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
