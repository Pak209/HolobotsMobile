            "order"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemaVersion": {
              "const": "zone-run-5"
            },
            "operation": {
              "const": "utility"
            },
            "requestId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            "runId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
