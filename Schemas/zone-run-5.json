          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemaVersion": {
              "const": "zone-run-5"
            },
            "operation": {
              "const": "signature"
            },
            "requestId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            "runId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            "signature": {
              "$ref": "#/$defs/signatureKind"
            },
            "holobotId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            "targetSectorId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            }
          },
          "required": [
            "schemaVersion",
            "operation",
            "requestId",
            "runId",
            "signature",
            "holobotId"
          ],
          "if": {
            "properties": {
              "signature": {
                "const": "forecast"
              }
            }
          },
          "then": {
            "required": [
              "targetSectorId"
            ]
          },
          "else": {
            "not": {
              "required": [
                "targetSectorId"
              ]
            }
          },
          "description": "Use a signature at the host's current sector. targetSectorId is required for forecast (a sector ahead) and forbidden for every other kind."
        }
