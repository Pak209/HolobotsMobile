{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "duel-receipt-1",
  "title": "Host duel receipt; value of rival settle reply.duelReceipt",
  "description": "Mirror of HolobotsMobile PR #85 DuelReceipt. rounds is a chronological action log: two actions per numbered round, at most 120 rounds. Shape validation does not establish authenticity or replace host resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "seed",
    "winner",
    "reason",
    "rounds",
    "playerFinal",
    "opponentFinal"
  ],
  "properties": {
    "schemaVersion": {
      "const": "duel-receipt-1"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "winner": {
      "enum": [
        "player",
        "opponent"
      ]
    },
    "reason": {
      "enum": [
        "knockout",
        "round_limit"
      ]
    },
    "rounds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 240,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "playerFinal": {
      "$ref": "#/$defs/team"
    },
    "opponentFinal": {
      "$ref": "#/$defs/team"
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "side",
        "attacker",
        "defender",
        "move",
        "moveId",
        "requested",
        "hit",
        "damage",
        "defenderHpAfter",
        "staAfter",
        "syncAfter"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "side": {
          "enum": [
            "player",
            "opponent"
          ]
        },
        "attacker": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        "defender": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        "move": {
          "enum": [
            "strike",
            "heavy",
            "defend",
            "finisher",
            "wait"
          ]
        },
        "moveId": {
          "type": "string",
          "maxLength": 128
        },
        "requested": {
          "enum": [
            "strike",
            "heavy",
            "defend",
            "finisher"
          ]
        },
        "hit": {
          "type": "boolean"
        },
        "damage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "defenderHpAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "staAfter": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "syncAfter": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "refusal": {
          "enum": [
            "insufficient_stamina",
            "sync_not_ready",
            "knocked_out"
          ]
        }
      }
    },
    "fighter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holobotId",
        "currentHealth",
        "maxHealth",
        "stamina",
        "maxStamina",
        "sync"
      ],
      "properties": {
        "holobotId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        "currentHealth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maxHealth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "stamina": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "maxStamina": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "sync": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "team": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/fighter"
      }
    }
  }
}
