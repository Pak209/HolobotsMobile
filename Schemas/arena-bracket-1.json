{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://holobots.local/schemas/arena-bracket-1.json",
  "title": "Arena bracket reply \u2014 fighter level publication contract",
  "description": "Additive reply projection: existing entrant.fighter includes holobotId, level, tier and canonical displayName. No new entrant-level keys; strict Unity parser compatibility preserved. Stored brackets and hashes unchanged.",
  "type": "object",
  "required": [
    "schemaVersion",
    "matchId",
    "alreadyProcessed",
    "bracket",
    "cancelled"
  ],
  "properties": {
    "schemaVersion": {
      "const": "arena-bracket-1"
    },
    "matchId": {
      "type": "string",
      "pattern": "^am_[a-f0-9]{32}$"
    },
    "alreadyProcessed": {
      "type": "boolean"
    },
    "cancelled": {
      "type": "boolean"
    },
    "bracket": {
      "type": "object",
      "required": [
        "schemaVersion",
        "entrants"
      ],
      "properties": {
        "schemaVersion": {
          "const": "arena-bracket-1"
        },
        "entrants": {
          "type": "array",
          "minItems": 8,
          "maxItems": 9,
          "items": {
            "type": "object",
            "required": [
              "entrantId",
              "pilotName",
              "holobotId",
              "isPlayer",
              "fighter"
            ],
            "properties": {
              "entrantId": {
                "type": "string",
                "minLength": 1
              },
              "pilotName": {
                "type": "string",
                "minLength": 1
              },
              "holobotId": {
                "type": "string",
                "minLength": 1
              },
              "isPlayer": {
                "type": "boolean"
              },
              "fighter": {
                "type": "object",
                "required": [
                  "holobotId",
                  "level",
                  "displayName",
                  "tier"
                ],
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 99
                  },
                  "holobotId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,39}$"
                  },
                  "displayName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tier": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
