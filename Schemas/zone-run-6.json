    "utilityResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the host resolved for this utility use. effect none = nothing to do here (route already open, barrier already down, haul full): not spent, no cooldown.",
      "properties": {
        "sectorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "utility": {
          "enum": [
            "ace",
            "shadow",
            "kuma"
          ]
        },
        "effect": {
          "enum": [
            "route",
            "cache",
            "clear",
            "none"
          ]
        },
        "opensSectorId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "haul": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/haul"
          },
          "maxItems": 9,
          "description": "Rows this use added; also present (unbanked) in run.haul."
        },
        "spent": {
          "type": "boolean"
        },
        "cooldownMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sectorId",
        "utility",
        "effect",
        "opensSectorId",
        "haul",
        "spent",
        "cooldownMs"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "spent": {
                "const": false
              },
              "cooldownMs": {
                "type": "null"
              },
              "opensSectorId": {
                "type": "null"
              },
              "haul": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "spent": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "route"
              }
            }
          },
          "then": {
            "properties": {
              "opensSectorId": {
                "type": "string"
              },
              "haul": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "cache"
              }
            }
          },
          "then": {
            "properties": {
              "opensSectorId": {
                "type": "null"
              },
              "haul": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "clear"
              }
            }
          },
          "then": {
            "properties": {
              "opensSectorId": {
                "type": "null"
              },
              "haul": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
