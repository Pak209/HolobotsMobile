{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://holobots.local/schemas/arena-match-request-3v3-1.json",
  "title": "PROPOSAL: Arena 3v3 lifecycle requests (arena-match-3v3-1). No host implements this yet.",
  "description": "Structural validation only. The host also checks ownership of all three bots, living vitals, balances, the current turn, the phase, and every swap target. Clients never send levels, HP for bench fighters, rewards, prices or outcomes. The arena-match-1 request schema is unchanged.",
  "definitions": {
    "matchId": {
      "type": "string",
      "pattern": "^a3_[a-f0-9]{32}$"
    },
    "requestToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,80}$"
    },
    "holobotId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "turn": {
      "description": "The host's current battle.turn, echoed back. Every in-match intent must carry it.",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "observedHealth": {
      "type": "number",
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operation",
        "requestId",
        "tierId",
        "paymentMethod",
        "holobotIds"
      ],
      "properties": {
        "schemaVersion": {
          "const": "arena-match-3v3-1"
        },
        "operation": {
          "const": "issue"
        },
        "requestId": {
          "$ref": "#/definitions/requestToken"
        },
        "tierId": {
          "enum": [
            "rookie",
            "challenger",
            "elite",
            "legend"
          ]
        },
        "paymentMethod": {
          "enum": [
            "pass",
            "tokens"
          ]
        },
        "holobotIds": {
          "description": "Three distinct owned bots in send-out order. Slot 0 leads. The host freezes each one as an arena fighter snapshot (#118). The host picks the CPU team; the client names no opponents.",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/holobotId"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operation",
        "matchId"
      ],
      "properties": {
        "schemaVersion": {
          "const": "arena-match-3v3-1"
        },
        "operation": {
          "const": "start"
        },
        "matchId": {
          "$ref": "#/definitions/matchId"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operation"
      ],
      "properties": {
        "schemaVersion": {
          "const": "arena-match-3v3-1"
        },
        "operation": {
          "const": "resume"
        },
        "matchId": {
          "$ref": "#/definitions/matchId"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operation",
        "matchId",
        "intentId",
        "turn",
        "activeHealth",
        "opponentHealth"
      ],
      "properties": {
        "schemaVersion": {
          "const": "arena-match-3v3-1"
        },
        "operation": {
          "const": "report",
          "description": "Client-observed bout checkpoint for the two ACTIVE fighters only. The host clamps it against its own vitals: HP can only go down, never above the host's current value, and never both to zero. This is the same trust boundary as arena-match-1 settle. A host-simulated bout can replace it later without changing the swap shape."
        },
        "matchId": {
          "$ref": "#/definitions/matchId"
        },
        "intentId": {
          "$ref": "#/definitions/requestToken"
        },
        "turn": {
          "$ref": "#/definitions/turn"
        },
        "activeHealth": {
          "$ref": "#/definitions/observedHealth"
        },
        "opponentHealth": {
          "$ref": "#/definitions/observedHealth"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operation",
        "matchId",
        "intentId",
        "turn",
        "holobotId"
      ],
      "properties": {
        "schemaVersion": {
          "const": "arena-match-3v3-1"
        },
        "operation": {
          "const": "swap",
          "description": "Roster intent only. It carries no HP, STA or level. The host checks the turn, the phase (a voluntary swap in command, or a forced send-in in send_in), and that the target is on the team, alive and not active."
        },
        "matchId": {
          "$ref": "#/definitions/matchId"
        },
        "intentId": {
          "$ref": "#/definitions/requestToken"
        },
        "turn": {
          "$ref": "#/definitions/turn"
        },
        "holobotId": {
          "$ref": "#/definitions/holobotId"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operation",
        "matchId",
        "combosCompleted",
        "perfectDefenses"
      ],
      "properties": {
        "schemaVersion": {
          "const": "arena-match-3v3-1"
        },
        "operation": {
          "const": "settle",
          "description": "Legal only in phase over. The host already holds the outcome and every fighter's vitals, so settle carries no HP and no outcome."
        },
        "matchId": {
          "$ref": "#/definitions/matchId"
        },
        "combosCompleted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "perfectDefenses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operation",
        "matchId"
      ],
      "properties": {
        "schemaVersion": {
          "const": "arena-match-3v3-1"
        },
        "operation": {
          "const": "cancel",
          "description": "Before start: one refund of the one entry charge. After start: a forfeit that writes the host-held vitals. Carries no client HP."
        },
        "matchId": {
          "$ref": "#/definitions/matchId"
        }
      }
    }
  ]
}
