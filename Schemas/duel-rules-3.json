        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$",
          "description": "stable lowercase bot id, unique in the roster"
        },
        "side": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "description": "0 or 1; a side's roster = its entries in array order, the first standing one is fielded at tick 0 [integer]"
        },
        "maxHp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "host stat [integer]"
        },
        "hp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "host stat, HP carried in (0 = no health: never fielded) [integer]"
