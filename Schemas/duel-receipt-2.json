{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "duel-receipt-2",
  "title": "Host-verified fight receipt (duel-sim-3 replay); value of rival or expedition settle reply.fightReceipt",
  "description": "fight-flow H1 (HolobotsMobile fight-host-1, DECISIONS #72.18, brief C0). In rival-battle mode input-log the host re-runs the client's duel-inputs-2 log through its bit-exact duel-sim-3 twin under the ISSUED duel-rules-3 snapshot, seed and CPU profile/rank, verifies the client's hash trail, and settles the outcome IT computed; this receipt is that outcome plus the evidence for the post-fight card. It is persisted once with the settlement and returned verbatim on every replayed settle. A rejected log produces no receipt (callable failed-precondition, rejectionCode replay_mismatch with the first divergent window). Shape validation does not establish authenticity; only the host's own replay does. duel-receipt-1 (resolver) is unchanged and stays the async/lite fallback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "simVersion",
    "battleId",
    "rulesId",
    "rulesHash",
    "seed",
    "inputsHash",
    "verified",
    "winner",
    "reason",
    "endTick",
    "tickCount",
    "playerSide",
    "playerFinal",
    "opponentFinal",
    "checkpoints",
    "witness"
  ],
  "properties": {
    "schemaVersion": {
      "const": "duel-receipt-2"
    },
    "simVersion": {
      "const": "duel-sim-3"
    },
    "battleId": {
      "type": "string",
      "pattern": "^(?:rb_|ef_)[a-zA-Z0-9_-]{1,128}(?![\\s\\S])"
    },
    "rulesId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}(?![\\s\\S])"
    },
    "rulesHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "seed": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "inputsHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "description": "SHA-256 of the canonical (host re-encoded) duel-inputs-2 wire JSON that was replayed"
    },
    "verified": {
      "const": true
    },
    "winner": {
      "enum": [
        "player",
        "opponent",
        "draw"
      ]
    },
    "reason": {
      "enum": [
        "ko",
        "timeout"
      ]
    },
    "endTick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7199
    },
    "tickCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200
    },
    "playerSide": {
      "const": 0
    },
    "playerFinal": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fighterId",
          "holobotId",
          "currentHealth",
          "maxHealth",
          "staminaPm",
          "sync",
          "knockedOut",
          "fielded"
        ],
        "properties": {
          "fighterId": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}(?![\\s\\S])"
          },
          "holobotId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,127}(?![\\s\\S])"
          },
          "currentHealth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "maxHealth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "staminaPm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "sync": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "knockedOut": {
            "type": "boolean"
          },
          "fielded": {
            "type": "boolean"
          }
        }
      }
    },
    "opponentFinal": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fighterId",
          "holobotId",
          "currentHealth",
          "maxHealth",
          "staminaPm",
          "sync",
          "knockedOut",
          "fielded"
        ],
        "properties": {
          "fighterId": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}(?![\\s\\S])"
          },
          "holobotId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,127}(?![\\s\\S])"
          },
          "currentHealth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "maxHealth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "staminaPm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "sync": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "knockedOut": {
            "type": "boolean"
          },
          "fielded": {
            "type": "boolean"
          }
        }
      }
    },
    "checkpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hashEvery",
        "hashes",
        "finalHash"
      ],
      "properties": {
        "hashEvery": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "hashes": {
          "type": "string",
          "maxLength": 115200,
          "pattern": "^(?:[0-9a-f]{16})*(?![\\s\\S])",
          "description": "the verified 16-hex state-hash samples (duel-inputs-2 hashes)"
        },
        "finalHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticks",
        "exchangeLengths",
        "exchangeHistogram1s",
        "exchangesIn2To5Pm",
        "exchangeMedianTicks",
        "probeLengths",
        "trades",
        "railFires",
        "sides"
      ],
      "description": "FightWitness.ToJson verbatim (duel-sim-3): measurements only, a pure function of the replayed state stream.",
      "properties": {
        "ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "exchangeLengths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "maxItems": 7200
        },
        "exchangeHistogram1s": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "minItems": 8,
          "maxItems": 8,
          "description": "1 s bins, last >= 7 s"
        },
        "exchangesIn2To5Pm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "exchangeMedianTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "probeLengths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "maxItems": 7200
        },
        "trades": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "railFires": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "sides": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ticksInState",
              "forcedBreaks",
              "voluntaryBreaks",
              "lineCrossings",
              "breakLengths",
              "telegraphs",
              "feints",
              "feintBaits",
              "steps",
              "shoves",
              "hits",
              "blocks",
              "perfectGuards",
              "guardBreaks",
              "whiffs",
              "evades",
              "counters",
              "hardHits",
              "swaps",
              "forcedSwaps",
              "escapes",
              "charges",
              "stamina"
            ],
            "properties": {
              "ticksInState": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "minItems": 5,
                "maxItems": 5,
                "description": "OUT, EDGE, EXCH, CLOSE, BREAK ticks"
              },
              "forcedBreaks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "voluntaryBreaks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "lineCrossings": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "breakLengths": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "maxItems": 7200
              },
              "telegraphs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "feints": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "feintBaits": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "steps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "shoves": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "hits": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "blocks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "perfectGuards": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "guardBreaks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "whiffs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "evades": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "counters": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "hardHits": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "swaps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "forcedSwaps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "escapes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647,
                "description": "duel-sim-3 r3 (fight-tune-2): quick escapes started"
              },
              "charges": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647,
                "description": "duel-sim-3 r3 (fight-tune-2): ShoulderCharges started"
              },
              "stamina": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "maxItems": 481,
                "description": "stamina per-mille sampled every 15 ticks"
              }
            }
          }
        }
      }
    }
  },
  "examples": []
}
