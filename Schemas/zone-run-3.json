            },
            "repairKits": {
              "type": "integer",
              "minimum": 0
            },
            "run": {
              "anyOf": [
                {
                  "$ref": "#/$defs/run"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
